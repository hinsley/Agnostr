{
  "name": "pwa-nostr-chat",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:solar-maps": "node scripts/check-solar-maps.mjs",
    "test:solar-tiles": "node --experimental-strip-types --test scripts/check-solar-tiles.mjs",
    "test:lunar-orientation": "node --experimental-strip-types --test scripts/check-lunar-orientation.mjs",
    "test:content-filter": "node --experimental-strip-types --test scripts/check-content-filter-worker.mjs",
    "test:agmail-reply-chain": "node --experimental-strip-types --test scripts/check-agmail-reply-chain.mjs",
    "test:room-roster": "node --experimental-strip-types --test scripts/check-room-roster.mjs",
    "test:agwallet": "node --test scripts/check-boltz-recovery-only.mjs scripts/check-lightning-melt-recovery.mjs scripts/check-native-bitcoin-send.mjs scripts/check-wallet-custody-boundary.mjs",
    "test:pwa-first-paint": "node scripts/check-pwa-first-paint.mjs",
    "test:push": "node --test scripts/check-push-client.mjs scripts/check-push-display.mjs",
    "test:poker": "node --experimental-strip-types --test scripts/check-poker-governance.mjs",
    "test:notification-shortcut": "node --experimental-strip-types --test scripts/check-notification-shortcut.mjs",
    "test:inline-chat-image": "node --experimental-strip-types --test scripts/check-inline-chat-image.mjs",
    "test:inline-chat-voice": "node --experimental-strip-types --test scripts/check-inline-chat-voice.mjs",
    "build:android-web": "tsc -b && vite build --mode android",
    "android:apk": "bash scripts/build-android-apk.sh",
    "test:nearby": "node --experimental-strip-types --test scripts/check-nearby-mesh.mjs"
  },
  "dependencies": {
    "@agnostr/mesh-curves": "npm:@noble/curves@2.4.0",
    "@capacitor/android": "8.6.3",
    "@capacitor/core": "8.6.3",
    "@cashu/cashu-ts": "^4.13.1",
    "@huggingface/transformers": "^4.3.2",
    "@noble/curves": "1.2.0",
    "@noble/hashes": "1.3.1",
    "@types/three": "^0.187.0",
    "highlight.js": "^11.12.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.76.0",
    "mathjax-full": "^3.2.1",
    "nostr-tools": "^2.16.2",
    "pako": "2.1.0",
    "parakeet.js": "^1.4.4",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.3",
    "@eslint/js": "^9.33.0",
    "@types/node": "^24.3.0",
    "@types/pako": "2.0.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.2",
    "vite-plugin-pwa": "^1.0.3",
    "workbox-cacheable-response": "^7.3.0",
    "workbox-core": "^7.3.0",
    "workbox-expiration": "^7.3.0",
    "workbox-precaching": "^7.3.0",
    "workbox-routing": "^7.3.0",
    "workbox-strategies": "^7.3.0"
  }
}
